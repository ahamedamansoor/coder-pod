        {
          command: 'Canvas Coordinate System',
          description: 'Understanding canvas coordinates and units',
          usage: 'Work with canvas coordinate system',
          example: `// Canvas coordinate system
// Origin (0,0) is top-left corner
// X increases to the right
// Y increases downward

const canvas = document.getElementById('myCanvas');
const ctx = canvas.getContext('2d');

// Draw coordinate system indicators
ctx.strokeStyle = '#ccc';
ctx.lineWidth = 1;

// Draw grid
for (let x = 0; x <= canvas.width; x += 50) {
  ctx.beginPath();
  ctx.moveTo(x, 0);
  ctx.lineTo(x, canvas.height);
  ctx.stroke();
}

for (let y = 0; y <= canvas.height; y += 50) {
  ctx.beginPath();
  ctx.moveTo(0, y);
  ctx.lineTo(canvas.width, y);
  ctx.stroke();
}

// Mark origin
ctx.fillStyle = 'red';
ctx.beginPath();
ctx.arc(0, 0, 5, 0, Math.PI * 2);
ctx.fill();

// Coordinate examples
ctx.fillStyle = 'blue';
ctx.fillRect(100, 100, 50, 50); // x=100, y=100

ctx.fillStyle = 'green';
ctx.fillRect(300, 200, 50, 50); // x=300, y=200

// Transform coordinate system
ctx.save();
ctx.translate(100, 100); // Move origin to (100, 100)
ctx.fillStyle = 'purple';
ctx.fillRect(0, 0, 50, 50); // Now at (100, 100) in original coordinates
ctx.restore();`
