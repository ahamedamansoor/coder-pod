      <button id="runMain" style="width: 100%; padding: 12px; background: linear-gradient(135deg, #f59e0b, #fbbf24); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; margin-bottom: 10px;">
        Calculate (Blocks UI)
      </button>
      <div id="mainResult" style="padding: 10px; background: white; border-radius: 6px; min-height: 60px; font-size: 14px; color: #475569;"></div>
    </div>
    
    <div style="padding: 15px; background: #dcfce7; border-radius: 10px; border: 2px solid #86efac;">
      <h3 style="color: #16a34a; margin-bottom: 10px; font-size: 16px;">✅ Web Worker</h3>
      <button id="runWorker" style="width: 100%; padding: 12px; background: linear-gradient(135deg, #16a34a, #22c55e); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; margin-bottom: 10px;">
        Calculate (Non-Blocking)
      </button>
      <div id="workerResult" style="padding: 10px; background: white; border-radius: 6px; min-height: 60px; font-size: 14px; color: #475569;"></div>
    </div>
  </div>

  <div style="padding: 15px; background: #f0f9ff; border-radius: 10px; border: 2px solid #7dd3fc; margin-bottom: 15px;">
    <h3 style="color: #0369a1; margin-bottom: 10px;">Test UI Responsiveness:</h3>
    <input type="range" id="slider" min="0" max="100" value="50" style="width: 100%; margin-bottom: 8px;" />
    <div style="display: flex; justify-content: space-between; font-size: 13px; color: #0369a1;">
      <span>Value: <strong id="sliderValue">50</strong></span>
      <span id="uiStatus" style="font-weight: bold;">UI Responsive ✓</span>
    </div>
  </div>

  <div style="padding: 12px; background: #fef3c7; border-radius: 8px; border: 2px solid #fcd34d;">
    <strong style="color: #92400e;">💡 Try this:</strong> 
    <span style="color: #78350f;">Click both buttons and move the slider. Notice the difference!</span>
