          usage: 'arc(), arcTo(), quadraticCurveTo(), bezierCurveTo()',
          example: `const canvas = document.getElementById('myCanvas');
const ctx = canvas.getContext('2d');

// Full circle
ctx.beginPath();
ctx.arc(100, 100, 50, 0, Math.PI * 2);
ctx.fillStyle = 'lightblue';
ctx.fill();
ctx.strokeStyle = 'blue';
ctx.stroke();

// Partial arc (semi-circle)
ctx.beginPath();
ctx.arc(250, 100, 50, 0, Math.PI);
ctx.strokeStyle = 'red';
ctx.lineWidth = 3;
ctx.stroke();

// Multiple arcs
ctx.beginPath();
ctx.arc(400, 100, 30, 0, Math.PI * 0.5);
ctx.strokeStyle = 'green';
ctx.stroke();

ctx.beginPath();
ctx.arc(400, 100, 40, Math.PI * 0.5, Math.PI);
ctx.strokeStyle = 'orange';
ctx.stroke();

// Quadratic curve
ctx.beginPath();
ctx.moveTo(50, 200);
ctx.quadraticCurveTo(100, 150, 150, 200);
ctx.strokeStyle = 'purple';
ctx.lineWidth = 2;
ctx.stroke();

// Bezier curve
ctx.beginPath();
ctx.moveTo(200, 200);
ctx.bezierCurveTo(250, 150, 350, 250, 400, 200);
ctx.strokeStyle = 'darkgreen';
ctx.lineWidth = 2;
ctx.stroke();

// ArcTo (rounded corner)
ctx.beginPath();
ctx.moveTo(50, 300);
ctx.arcTo(150, 300, 150, 350, 50);
ctx.arcTo(150, 350, 50, 350, 50);
ctx.arcTo(50, 350, 50, 300, 50);
ctx.closePath();
ctx.fillStyle = 'lightcoral';
ctx.fill();`
