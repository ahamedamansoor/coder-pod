        js={`// Simulated heavy computation (Fibonacci)
function heavyComputation(n) {
  if (n <= 1) return n;
  return heavyComputation(n - 1) + heavyComputation(n - 2);
}

// Track UI responsiveness
const slider = document.getElementById('slider');
const sliderValue = document.getElementById('sliderValue');
const uiStatus = document.getElementById('uiStatus');
let lastUpdate = Date.now();

slider.addEventListener('input', (e) => {
  sliderValue.textContent = e.target.value;
  lastUpdate = Date.now();
  uiStatus.textContent = 'UI Responsive ✓';
  uiStatus.style.color = '#16a34a';
});

// Check if UI is frozen
setInterval(() => {
  const timeSinceUpdate = Date.now() - lastUpdate;
  if (timeSinceUpdate > 1000) {
    uiStatus.textContent = 'UI Frozen! ⚠️';
    uiStatus.style.color = '#dc2626';
  }
}, 100);

// Main thread calculation (BLOCKS UI)
document.getElementById('runMain').addEventListener('click', function() {
  const btn = this;
  const result = document.getElementById('mainResult');
  
  btn.disabled = true;
  btn.textContent = '⏳ Calculating...';
  result.innerHTML = '<div style=\"color: #f59e0b;\">Computing on main thread...<br>Try moving the slider!</div>';
  
  // Use setTimeout to allow UI to update
  setTimeout(() => {
    const start = performance.now();
    const answer = heavyComputation(40); // Heavy calculation
    const duration = (performance.now() - start).toFixed(0);
    
    result.innerHTML = '<strong style=\"color: #d97706;\">Result: ' + answer + '</strong><br><span style=\"font-size: 12px; color: #78350f;\">Time: ' + duration + 'ms<br>❌ UI was blocked!</span>';
    btn.disabled = false;
    btn.textContent = 'Calculate (Blocks UI)';
  }, 50);
});

// Web Worker calculation (NON-BLOCKING)
document.getElementById('runWorker').addEventListener('click', function() {
  const btn = this;
  const result = document.getElementById('workerResult');
  
  btn.disabled = true;
  btn.textContent = '⏳ Calculating...';
  result.innerHTML = '<div style=\"color: #16a34a;\">Computing in background thread...<br>Move the slider - still responsive!</div>';
  
  // Create inline worker using Blob
  const workerCode = 'self.onmessage = function(e) { function fib(n) { if (n <= 1) return n; return fib(n - 1) + fib(n - 2); } const start = Date.now(); const result = fib(e.data); const duration = Date.now() - start; self.postMessage({ result, duration }); };';
  
  const blob = new Blob([workerCode], { type: 'application/javascript' });
  const worker = new Worker(URL.createObjectURL(blob));
  
  const start = performance.now();
  
  worker.onmessage = function(e) {
    const totalDuration = (performance.now() - start).toFixed(0);
    result.innerHTML = '<strong style=\"color: #16a34a;\">Result: ' + e.data.result + '</strong><br><span style=\"font-size: 12px; color: #15803d;\">Time: ' + totalDuration + 'ms<br>✅ UI stayed responsive!</span>';
    btn.disabled = false;
    btn.textContent = 'Calculate (Non-Blocking)';
    worker.terminate();
  };
  
  worker.postMessage(40); // Send computation task
});`}
        colorTheme="yellow"
      />

      {/* Basic Web Worker Setup */}
      <Card className="border-2 border-purple-200 dark:border-purple-800/30">
        <CardHeader>
          <div className="flex items-center gap-3">
            <div className="p-2 rounded-lg bg-purple-100 dark:bg-purple-900/30">
              <Cpu className="w-5 h-5 text-purple-600 dark:text-purple-400" />
            </div>
            <div>
              <CardTitle>Creating a Web Worker - The Basics</CardTitle>
              <CardDescription>Three simple steps to use Web Workers</CardDescription>
            </div>
          </div>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="space-y-4">
            {/* Step 1 */}
            <div className="p-4 rounded-lg bg-gradient-to-r from-purple-50 to-pink-50 dark:from-purple-950/20 dark:to-pink-950/20 border-l-4 border-purple-500">
              <h4 className="font-bold text-purple-900 dark:text-purple-100 mb-2 flex items-center gap-2">
                <span className="px-2 py-1 bg-purple-500 text-white rounded text-sm">1</span>
                Create a Worker File (worker.js)
              </h4>
              <pre className="bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 p-4 rounded-lg overflow-x-auto text-sm font-mono mt-2 border border-slate-200 dark:border-slate-700">
{`// worker.js - Runs in separate thread
self.onmessage = function(e) {
  console.log('Worker received:', e.data);
  
  // Perform heavy computation
  const result = heavyTask(e.data);
  
  // Send result back to main thread
  self.postMessage(result);
};

function heavyTask(data) {
  let sum = 0;
  for (let i = 0; i < data; i++) {
    sum += Math.sqrt(i);
  }
  return sum;
}`}</pre>
            </div>

            {/* Step 2 */}
            <div className="p-4 rounded-lg bg-gradient-to-r from-pink-50 to-rose-50 dark:from-pink-950/20 dark:to-rose-950/20 border-l-4 border-pink-500">
              <h4 className="font-bold text-pink-900 dark:text-pink-100 mb-2 flex items-center gap-2">
                <span className="px-2 py-1 bg-pink-500 text-white rounded text-sm">2</span>
                Create Worker in Main Thread (main.js)
              </h4>
              <pre className="bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 p-4 rounded-lg overflow-x-auto text-sm font-mono mt-2 border border-slate-200 dark:border-slate-700">
{`// main.js - Create worker ONCE
let worker;

function initWorker() {
  // Create worker only if not already created
  if (!worker) {
    worker = new Worker('worker.js');
    
    // Set up message handler
    worker.onmessage = function(e) {
      console.log('Result:', e.data);
      displayResult(e.data);
    };
    
    // Handle errors
    worker.onerror = function(error) {
      console.error('Worker error:', error);
    };
  }
}`}</pre>
            </div>

            {/* Step 3 */}
            <div className="p-4 rounded-lg bg-gradient-to-r from-rose-50 to-orange-50 dark:from-rose-950/20 dark:to-orange-950/20 border-l-4 border-rose-500">
              <h4 className="font-bold text-rose-900 dark:text-rose-100 mb-2 flex items-center gap-2">
                <span className="px-2 py-1 bg-rose-500 text-white rounded text-sm">3</span>
                Send Messages When Needed
              </h4>
              <pre className="bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 p-4 rounded-lg overflow-x-auto text-sm font-mono mt-2 border border-slate-200 dark:border-slate-700">
{`// Send messages only when user triggers action
button.addEventListener('click', () => {
  initWorker(); // Ensure worker exists
  
  // Send task to worker
  worker.postMessage(1000000);
  console.log('Task sent to worker...');
});

// Clean up when done
function cleanup() {
  if (worker) {
    worker.terminate();
    worker = null;
    console.log('Worker terminated');
  }
}`}</pre>
            </div>
          </div>

          <Alert className="bg-amber-50 dark:bg-amber-950/20 border-amber-200 dark:border-amber-800/30">
            <Lightbulb className="h-5 w-5 text-amber-600 dark:text-amber-400" />
            <AlertTitle>Important: Avoid Continuous Creation</AlertTitle>
            <AlertDescription>
              Create the worker <strong>once</strong> and reuse it. Don't create new workers on every function call or render. Check if worker exists before creating a new one to prevent memory leaks and performance issues.
            </AlertDescription>
          </Alert>
        </CardContent>
      </Card>

      {/* Real-World Example */}
      <FrontendCodePreview
        title="Real-World: Image Processing with Web Worker"
        html={`<div style="max-width: 600px; margin: 0 auto;">
  <h2 style="color: #ec4899; margin-bottom: 20px;">Image Filter Demo</h2>
  
  <div style="display: flex; gap: 12px; margin-bottom: 15px;">
    <div style="flex: 1; padding: 12px; background: #fce7f3; border-radius: 8px; text-align: center;">
      <div style="font-size: 11px; color: #ec4899; margin-bottom: 4px;">Processing Time</div>
      <div id="processingTime" style="font-size: 20px; font-weight: bold; color: #be185d;">0 ms</div>
    </div>
    <div style="flex: 1; padding: 12px; background: #f0f9ff; border-radius: 8px; text-align: center;">
      <div style="font-size: 11px; color: #0284c7; margin-bottom: 4px;">UI Status</div>
      <div id="imageUiStatus" style="font-size: 16px; font-weight: bold; color: #0369a1;">Ready ✓</div>
    </div>
  </div>

  <div style="border: 2px solid #f9a8d4; border-radius: 10px; padding: 15px; background: #fdf2f8; margin-bottom: 15px;">
    <canvas id="canvas" width="300" height="200" style="width: 100%; height: auto; border-radius: 6px; background: #e9d5ff;"></canvas>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
    <button id="applyGrayscale" style="padding: 12px; background: linear-gradient(135deg, #ec4899, #f472b6); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold;">
      🎨 Grayscale Filter
    </button>
    <button id="applyInvert" style="padding: 12px; background: linear-gradient(135deg, #8b5cf6, #a78bfa); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold;">
      🔄 Invert Colors
    </button>
  </div>

  <div style="margin-top: 15px; padding: 12px; background: #dbeafe; border-radius: 8px; border: 2px solid #7dd3fc;">
    <strong style="color: #0369a1;">ℹ️ Info:</strong> 
    <span style="color: #0c4a6e;">Image processing runs in Web Worker - UI never freezes!</span>
  </div>
</div>`}
        css={`body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  padding: 20px;
}

button:hover:not(:disabled) {
  transform: scale(1.02);
  box-shadow: 0 4px 12px rgba(236, 72, 153, 0.3);
  transition: all 0.2s;
}

button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

canvas {
  display: block;
  image-rendering: pixelated;
}`}
        js={`const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

// Draw a colorful pattern
function drawPattern() {
  for (let x = 0; x < canvas.width; x += 10) {
    for (let y = 0; y < canvas.height; y += 10) {
      ctx.fillStyle = 'hsl(' + (x + y) + ', 70%, 60%)';
      ctx.fillRect(x, y, 10, 10);
    }
  }
}

drawPattern();

// Create inline worker for image processing
const workerCode = 'self.onmessage = function(e) { const { imageData, filter } = e.data; const data = imageData.data; if (filter === \"grayscale\") { for (let i = 0; i < data.length; i += 4) { const avg = (data[i] + data[i + 1] + data[i + 2]) / 3; data[i] = data[i + 1] = data[i + 2] = avg; } } else if (filter === \"invert\") { for (let i = 0; i < data.length; i += 4) { data[i] = 255 - data[i]; data[i + 1] = 255 - data[i + 1]; data[i + 2] = 255 - data[i + 2]; } } self.postMessage({ imageData }); };';

const blob = new Blob([workerCode], { type: 'application/javascript' });
const imageWorker = new Worker(URL.createObjectURL(blob));

function applyFilter(filterType) {
  const uiStatus = document.getElementById('imageUiStatus');
  uiStatus.textContent = 'Processing...';
  uiStatus.style.color = '#f59e0b';
  
  const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
  const start = performance.now();
  
  imageWorker.onmessage = function(e) {
    const duration = (performance.now() - start).toFixed(0);
    ctx.putImageData(e.data.imageData, 0, 0);
    
    document.getElementById('processingTime').textContent = duration + ' ms';
    uiStatus.textContent = 'Complete ✓';
    uiStatus.style.color = '#16a34a';
  };
  
  imageWorker.postMessage({ imageData, filter: filterType });
}

document.getElementById('applyGrayscale').addEventListener('click', function() {
  applyFilter('grayscale');
});

document.getElementById('applyInvert').addEventListener('click', function() {
  applyFilter('invert');
});`}
        colorTheme="yellow"
      />

      {/* Worker Limitations */}
      <Card>
        <CardHeader>
          <div className="flex items-center gap-3">
            <div className="p-2 rounded-lg bg-amber-100 dark:bg-amber-900/30">
              <Lightbulb className="w-5 h-5 text-amber-600 dark:text-amber-400" />
            </div>
            <div>
              <CardTitle>Web Worker Limitations</CardTitle>
              <CardDescription>What workers CAN and CANNOT do</CardDescription>
            </div>
          </div>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="grid md:grid-cols-2 gap-4">
            <div className="p-5 rounded-xl bg-green-50 dark:bg-green-950/20 border-2 border-green-200 dark:border-green-800/30">
              <h4 className="font-semibold text-green-900 dark:text-green-100 mb-3 flex items-center gap-2">
                <span className="text-xl">✅</span> Workers CAN Access
              </h4>
              <ul className="space-y-2 text-sm text-gray-700 dark:text-gray-300">
                <li className="flex items-start gap-2">
                  <span className="text-green-600 dark:text-green-400 mt-1">•</span>
                  <span><strong>JavaScript features</strong> - ES6+, promises, async/await</span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-green-600 dark:text-green-400 mt-1">•</span>
                  <span><strong>XMLHttpRequest & Fetch</strong> - Make network requests</span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-green-600 dark:text-green-400 mt-1">•</span>
                  <span><strong>Timers</strong> - setTimeout, setInterval</span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-green-600 dark:text-green-400 mt-1">•</span>
                  <span><strong>IndexedDB</strong> - Client-side storage</span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-green-600 dark:text-green-400 mt-1">•</span>
                  <span><strong>WebSockets</strong> - Real-time communication</span>
                </li>
              </ul>
            </div>

            <div className="p-5 rounded-xl bg-red-50 dark:bg-red-950/20 border-2 border-red-200 dark:border-red-800/30">
              <h4 className="font-semibold text-red-900 dark:text-red-100 mb-3 flex items-center gap-2">
                <span className="text-xl">❌</span> Workers CANNOT Access
              </h4>
              <ul className="space-y-2 text-sm text-gray-700 dark:text-gray-300">
                <li className="flex items-start gap-2">
                  <span className="text-red-600 dark:text-red-400 mt-1">•</span>
                  <span><strong>DOM</strong> - No document, window manipulation</span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-red-600 dark:text-red-400 mt-1">•</span>
                  <span><strong>Parent page objects</strong> - No access to main thread variables</span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-red-600 dark:text-red-400 mt-1">•</span>
                  <span><strong>localStorage</strong> - Use IndexedDB instead</span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-red-600 dark:text-red-400 mt-1">•</span>
                  <span><strong>alert/confirm</strong> - No UI blocking dialogs</span>
                </li>
              </ul>
            </div>
          </div>

          <Alert className="bg-blue-50 dark:bg-blue-950/20 border-blue-200 dark:border-blue-800/30">
            <Lightbulb className="h-5 w-5 text-blue-600 dark:text-blue-400" />
            <AlertTitle>Communication Only</AlertTitle>
            <AlertDescription>
              Workers communicate with the main thread through message passing (postMessage). Data is copied, not shared (except for Transferable objects).
            </AlertDescription>
          </Alert>
        </CardContent>
      </Card>

      {/* Best Practices */}
      <Card>
        <CardHeader>
          <div className="flex items-center gap-3">
            <div className="p-2 rounded-lg bg-emerald-100 dark:bg-emerald-900/30">
              <Sparkles className="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
            </div>
            <div>
              <CardTitle>Best Practices</CardTitle>
              <CardDescription>When and how to use Web Workers effectively</CardDescription>
            </div>
          </div>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="space-y-3">
            <div className="p-4 rounded-lg bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-950/20 dark:to-emerald-950/20 border-l-4 border-green-500">
              <h4 className="font-semibold text-green-900 dark:text-green-100 mb-2">✅ Use Workers For:</h4>
              <ul className="space-y-1 text-sm text-gray-700 dark:text-gray-300">
                <li>• Heavy calculations (data processing, crypto, compression)</li>
                <li>• Image/video processing</li>
                <li>• Large dataset manipulation</li>
                <li>• Real-time data analysis</li>
                <li>• Background sync operations</li>
              </ul>
            </div>

            <div className="p-4 rounded-lg bg-gradient-to-r from-red-50 to-orange-50 dark:from-red-950/20 dark:to-orange-950/20 border-l-4 border-red-500">
              <h4 className="font-semibold text-red-900 dark:text-red-100 mb-2">❌ Don't Use Workers For:</h4>
              <ul className="space-y-1 text-sm text-gray-700 dark:text-gray-300">
                <li>• Simple calculations (overhead not worth it)</li>
                <li>• Frequent small messages (use batching)</li>
                <li>• DOM manipulation (workers can't access DOM)</li>
                <li>• Tasks that need immediate results</li>
              </ul>
            </div>

            <div className="p-4 rounded-lg bg-gradient-to-r from-blue-50 to-cyan-50 dark:from-blue-950/20 dark:to-cyan-950/20 border-l-4 border-blue-500">
              <h4 className="font-semibold text-blue-900 dark:text-blue-100 mb-2">💡 Pro Tips:</h4>
              <ul className="space-y-1 text-sm text-gray-700 dark:text-gray-300">
                <li>• Reuse workers instead of creating new ones each time</li>
                <li>• Use Transferable objects for large data (zero-copy)</li>
                <li>• Always terminate workers when done to free memory</li>
                <li>• Handle errors with worker.onerror</li>
                <li>• Consider Shared Workers for multiple tabs</li>
              </ul>
            </div>
          </div>
        </CardContent>
      </Card>

      {/* Key Takeaways */}
      <Card className="border-2 border-yellow-300 dark:border-yellow-700 bg-gradient-to-br from-yellow-50 via-amber-50 to-orange-50 dark:from-yellow-950/20 dark:via-amber-950/10 dark:to-orange-950/10 shadow-lg">
        <CardContent className="pt-8">
          <div className="flex items-center gap-3 mb-6">
            <div className="p-3 rounded-xl bg-gradient-to-br from-yellow-400 to-amber-500 text-white shadow-lg">
              <Sparkles className="w-6 h-6" />
            </div>
            <h3 className="text-2xl font-bold text-gray-900 dark:text-gray-100">Key Takeaways</h3>
          </div>
          
          <div className="grid sm:grid-cols-2 gap-4">
            <div className="p-5 rounded-xl bg-white dark:bg-slate-900 border-2 border-yellow-200 dark:border-yellow-800/30">
              <div className="flex items-start gap-3">
                <span className="text-2xl">🧵</span>
                <div>
                  <h4 className="font-semibold mb-1.5 text-gray-900 dark:text-gray-100">Background Threads</h4>
                  <p className="text-sm text-gray-600 dark:text-gray-400">
                    Run heavy tasks in separate threads<br/>
                    Keep UI responsive and smooth<br/>
                    No freezing or blocking
                  </p>
                </div>
              </div>
            </div>

            <div className="p-5 rounded-xl bg-white dark:bg-slate-900 border-2 border-yellow-200 dark:border-yellow-800/30">
              <div className="flex items-start gap-3">
                <span className="text-2xl">💬</span>
                <div>
                  <h4 className="font-semibold mb-1.5 text-gray-900 dark:text-gray-100">Message Passing</h4>
                  <p className="text-sm text-gray-600 dark:text-gray-400">
                    postMessage to send data<br/>
                    onmessage to receive results<br/>
                    Data is copied, not shared
                  </p>
                </div>
              </div>
            </div>

            <div className="p-5 rounded-xl bg-white dark:bg-slate-900 border-2 border-yellow-200 dark:border-yellow-800/30">
              <div className="flex items-start gap-3">
                <span className="text-2xl">🚫</span>
                <div>
                  <h4 className="font-semibold mb-1.5 text-gray-900 dark:text-gray-100">No DOM Access</h4>
                  <p className="text-sm text-gray-600 dark:text-gray-400">
                    Workers can't touch the DOM<br/>
                    No window or document access<br/>
                    Pure computation only
                  </p>
                </div>
              </div>
            </div>

            <div className="p-5 rounded-xl bg-white dark:bg-slate-900 border-2 border-yellow-200 dark:border-yellow-800/30">
              <div className="flex items-start gap-3">
                <span className="text-2xl">⚡</span>
                <div>
                  <h4 className="font-semibold mb-1.5 text-gray-900 dark:text-gray-100">Performance Boost</h4>
                  <p className="text-sm text-gray-600 dark:text-gray-400">
                    Perfect for CPU-intensive tasks<br/>
                    Image/video processing<br/>
                    Data analysis and calculations
                  </p>
                </div>
              </div>
            </div>
          </div>

          <Alert className="mt-6 bg-purple-50 dark:bg-purple-950/20 border-purple-200 dark:border-purple-800/30">
            <Cpu className="h-5 w-5 text-purple-600 dark:text-purple-400" />
            <AlertTitle>Browser Support</AlertTitle>
            <AlertDescription className="text-base">
              Web Workers are supported in all modern browsers! Use them to unlock true multi-threading in JavaScript and keep your apps blazing fast.
            </AlertDescription>
          </Alert>
        </CardContent>
      </Card>
    </div>
  );
}
