          example: `const canvas = document.getElementById('myCanvas');
const ctx = canvas.getContext('2d');

// Simple line
ctx.beginPath();
ctx.moveTo(50, 50);
ctx.lineTo(200, 50);
ctx.strokeStyle = 'blue';
ctx.lineWidth = 2;
ctx.stroke();

// Connected lines
ctx.beginPath();
ctx.moveTo(50, 100);
ctx.lineTo(100, 150);
ctx.lineTo(150, 100);
ctx.lineTo(200, 150);
ctx.strokeStyle = 'red';
ctx.lineWidth = 3;
ctx.stroke();

// Complex path
ctx.beginPath();
ctx.moveTo(250, 50);
ctx.lineTo(300, 100);
ctx.lineTo(350, 50);
ctx.lineTo(400, 100);
ctx.lineTo(450, 50);
ctx.strokeStyle = 'green';
ctx.lineWidth = 2;
ctx.stroke();

// Closed path
ctx.beginPath();
ctx.moveTo(50, 200);
ctx.lineTo(100, 250);
ctx.lineTo(150, 250);
ctx.lineTo(200, 200);
ctx.closePath();
ctx.fillStyle = 'lightblue';
ctx.fill();
ctx.strokeStyle = 'darkblue';
ctx.stroke();

// Dashed line
ctx.setLineDash([5, 5]);
ctx.beginPath();
ctx.moveTo(250, 200);
ctx.lineTo(450, 200);
ctx.strokeStyle = 'purple';
ctx.stroke();

// Reset line dash
ctx.setLineDash([]);`
