// C/C++ code compiled to WASM (example: image processing)
// int* process_image(int* data, int width, int height, int brightness) {
//     for (int i = 0; i < width * height * 4; i += 4) {
//         data[i] = min(255, data[i] + brightness);     // Red
//         data[i + 1] = min(255, data[i + 1] + brightness); // Green
//         data[i + 2] = min(255, data[i + 2] + brightness); // Blue
//         // Alpha channel unchanged
//     }
//     return data;
// }

// JavaScript wrapper
class WASMImageProcessor {
  constructor() {
    this.wasmModule = null;
    this.memory = null;
  }
  
  async load() {
    const response = await fetch('image-processor.wasm');
    const wasmBuffer = await response.arrayBuffer();
    
    this.wasmModule = await WebAssembly.instantiate(wasmBuffer);
    this.memory = this.wasmModule.instance.exports.memory;
  }
  
  processImage(imageData, brightness) {
    const width = imageData.width;
    const height = imageData.height;
    const data = imageData.data;
    
    // Allocate memory in WASM
    const ptr = this.wasmModule.instance.exports.allocate(width * height * 4);
    
    // Copy image data to WASM memory
    const wasmData = new Uint8ClampedArray(this.memory.buffer, ptr, width * height * 4);
    wasmData.set(data);
    
    // Process in WASM
    this.wasmModule.instance.exports.process_image(ptr, width, height, brightness);
    
    // Copy result back
    const result = new Uint8ClampedArray(wasmData);
    imageData.data.set(result);
    
    // Free WASM memory
    this.wasmModule.instance.exports.deallocate(ptr);
    
    return imageData;
  }
}

// Usage
const processor = new WASMImageProcessor();
await processor.load();

const canvas = document.getElementById('myCanvas');
const ctx = canvas.getContext('2d');

const img = new Image();
img.onload = function() {
  ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
  
  const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
  const processedData = processor.processImage(imageData, 50);
  
  ctx.putImageData(processedData, 0, 0);
};
img.src = 'image.jpg';

// High-performance particle system with WASM
class WASMParticleSystem {
  constructor(particleCount) {
    this.particleCount = particleCount;
    this.wasmModule = null;
    this.particlesPtr = null;
  }
  
  async load() {
    const response = await fetch('particle-system.wasm');
    const wasmBuffer = await response.arrayBuffer();
    
    this.wasmModule = await WebAssembly.instantiate(wasmBuffer);
    
    // Allocate particle data
    this.particlesPtr = this.wasmModule.instance.exports.allocate_particles(this.particleCount);
  }
  
  update(deltaTime) {
    this.wasmModule.instance.exports.update_particles(
      this.particlesPtr,
      this.particleCount,
      deltaTime
    );
  }
  
  render(ctx) {
    const particles = new Float32Array(
      this.wasmModule.instance.exports.memory.buffer,
      this.particlesPtr,
      this.particleCount * 4 // x, y, vx, vy per particle
    );
    
    ctx.fillStyle = 'blue';
    for (let i = 0; i < this.particleCount; i++) {
      const x = particles[i * 4];
      const y = particles[i * 4 + 1];
      
      ctx.beginPath();
      ctx.arc(x, y, 2, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  
  destroy() {
    if (this.particlesPtr) {
      this.wasmModule.instance.exports.deallocate_particles(this.particlesPtr);
    }
  }
}`
