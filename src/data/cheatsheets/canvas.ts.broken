      title: 'Transformations',
      commands: [
        {
          command: 'Translation and Rotation',
          description: 'Move and rotate canvas content',
          usage: 'translate(), rotate(), save(), restore()',
          example: `const canvas = document.getElementById('myCanvas');
const ctx = canvas.getContext('2d');

// Translation
ctx.save();
ctx.translate(100, 100);
ctx.fillStyle = 'red';
ctx.fillRect(0, 0, 50, 50); // Now at (100, 100)
ctx.restore();

// Rotation
ctx.save();
ctx.translate(200, 100);
ctx.rotate(Math.PI / 4); // 45 degrees
ctx.fillStyle = 'blue';
ctx.fillRect(-25, -25, 50, 50); // Centered at rotation point
ctx.restore();

// Combined translation and rotation
ctx.save();
ctx.translate(300, 100);
ctx.rotate(Math.PI / 6); // 30 degrees
ctx.fillStyle = 'green';
ctx.fillRect(0, 0, 50, 30);
ctx.restore();

// Multiple transformations
ctx.save();
ctx.translate(100, 200);
ctx.rotate(Math.PI / 8);
ctx.translate(50, 0);
ctx.fillStyle = 'purple';
ctx.fillRect(-25, -25, 50, 50);
ctx.restore();

// Rotation around specific point
function rotateAroundPoint(x, y, angle) {
  ctx.translate(x, y);
  ctx.rotate(angle);
  ctx.translate(-x, -y);
}

ctx.save();
rotateAroundPoint(250, 250, Math.PI / 3);
ctx.fillStyle = 'orange';
ctx.fillRect(225, 225, 50, 50);
ctx.restore();

// Animated rotation
let angle = 0;
function animate() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  
  ctx.save();
  ctx.translate(350, 250);
  ctx.rotate(angle);
  ctx.fillStyle = 'darkblue';
  ctx.fillRect(-25, -25, 50, 50);
  ctx.restore();
  
  angle += 0.02;
  requestAnimationFrame(animate);
}
animate();`
        },
        {
          command: 'Scaling and Reflection',
