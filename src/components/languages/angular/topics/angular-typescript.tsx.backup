            <CodeSnippetWithOutput
              title="Decorators"
              description="Special syntax for adding metadata to classes and properties"
              code={`import { Component, Input, Output, EventEmitter } from '@angular/core';

@Component({
  selector: 'app-user-card',
  templateUrl: './user-card.component.html',
  styleUrls: ['./user-card.component.css']
})
export class UserCardComponent {
  // Input property with type
  @Input() user!: User;
  
  // Output event with typed EventEmitter
  @Output() userSelected = new EventEmitter<User>();
  
  // Input with transformation (Angular 16+)
  @Input({ transform: (value: string) => parseInt(value) })
  userId!: number;
  
  // Required input (Angular 16+)
  @Input({ required: true }) 
  userName!: string;
  
  onSelect(): void {
    this.userSelected.emit(this.user);
  }
}`}
              language="typescript"
              colorTheme="red"
            />

            <CodeSnippetWithOutput
              title="Dependency Injection with Types"
              description="Type-safe service injection"
              code={`import { Injectable } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Router } from '@angular/router';

@Injectable({
  providedIn: 'root'
})
export class UserService {
  // Services injected with types
  constructor(
    private http: HttpClient,
    private router: Router,
    private authService: AuthService
  ) {}
  
  async loadUser(id: number): Promise<User> {
    try {
      const user = await this.http
        .get<User>(\`/api/users/\${id}\`)
        .toPromise();
      
      return user!;
    } catch (error) {
      console.error('Failed to load user', error);
      throw error;
    }
  }
}`}
              language="typescript"
              colorTheme="blue"
            />

            <CodeSnippetWithOutput
              title="Typed Observables (RxJS)"
              description="Type-safe reactive programming"
              code={`import { Observable, Subject, BehaviorSubject } from 'rxjs';
import { map, filter, tap } from 'rxjs/operators';

export class UserStore {
  // BehaviorSubject with initial value
  private usersSubject = new BehaviorSubject<User[]>([]);
  
  // Public observable (readonly)
  users$: Observable<User[]> = this.usersSubject.asObservable();
  
  // Subject for events
  private userDeletedSubject = new Subject<number>();
  userDeleted$ = this.userDeletedSubject.asObservable();
  
  // Computed observable with type
  activeUsers$: Observable<User[]> = this.users$.pipe(
    map((users: User[]) => users.filter(u => u.isActive))
  );
  
  // Method updating state
  setUsers(users: User[]): void {
    this.usersSubject.next(users);
  }
  
  // Method emitting event
  notifyUserDeleted(userId: number): void {
    this.userDeletedSubject.next(userId);
  }
}`}
              language="typescript"
              colorTheme="purple"
            />

            <CodeSnippetWithOutput
              title="Typed Forms (Angular 14+)"
              description="Strongly-typed reactive forms"
              code={`import { FormControl, FormGroup, Validators } from '@angular/forms';

// Interface for form data
interface UserForm {
  name: string;
  email: string;
  age: number;
  address: string;
}

export class UserFormComponent {
  // Typed form group
  userForm = new FormGroup({
    name: new FormControl<string>('', {
      nonNullable: true,
      validators: [Validators.required]
    }),
    email: new FormControl<string>('', {
      nonNullable: true,
      validators: [Validators.required, Validators.email]
    }),
    age: new FormControl<number>(0, {
      nonNullable: true,
      validators: [Validators.min(0)]
    }),
    address: new FormControl<string>('', {
      nonNullable: true
    })
  });
  
  onSubmit(): void {
    if (this.userForm.valid) {
      // Type-safe form value
      const formData: UserForm = this.userForm.getRawValue();
      console.log(formData.name); // TypeScript knows it's a string
      console.log(formData.age);  // TypeScript knows it's a number
    }
  }
  
  // Type-safe value access
  get nameValue(): string {
    return this.userForm.controls.name.value;
  }
}`}
              language="typescript"
              colorTheme="emerald"
            />
