        </CardHeader>
        <CardContent>
          <Alert className="mb-6">
            <Sparkles className="h-4 w-4" />
            <AlertTitle>What are Generics?</AlertTitle>
            <AlertDescription>
              Generics allow you to create components that work with multiple types while maintaining type safety. Think of them as "type variables"!
            </AlertDescription>
          </Alert>

          <CodeSnippetWithOutput
            title="Generic Functions"
            description="Functions that work with any type"
            code={`// Generic function with type parameter T
function identity<T>(value: T): T {
  return value;
}

// Usage with different types
const num = identity<number>(42);
const str = identity<string>('hello');
const bool = identity<boolean>(true);

// Type inference (TypeScript figures it out)
const inferred = identity(123); // T is number

// Generic function with constraints
function getProperty<T, K extends keyof T>(obj: T, key: K): T[K] {
  return obj[key];
}

const user = { id: 1, name: 'Alice', age: 25 };
const userName = getProperty(user, 'name'); // string
const userAge = getProperty(user, 'age');   // number

// Generic with multiple type parameters
function pair<T, U>(first: T, second: U): [T, U] {
  return [first, second];
}

const result = pair<string, number>('age', 25);`}
            language="typescript"
            colorTheme="blue"
          />

          <CodeSnippetWithOutput
            title="Generic Interfaces and Classes"
            description="Reusable type-safe data structures"
            code={`// Generic interface
interface ApiResponse<T> {
  data: T;
  status: number;
  message: string;
  timestamp: Date;
}

// Usage with different data types
const userResponse: ApiResponse<User> = {
  data: { id: 1, name: 'Alice', email: 'alice@ex.com' },
  status: 200,
  message: 'Success',
  timestamp: new Date()
};

const usersResponse: ApiResponse<User[]> = {
  data: [/* array of users */],
  status: 200,
  message: 'Success',
  timestamp: new Date()
};

// Generic class
class DataStore<T> {
  private items: T[] = [];
  
  add(item: T): void {
    this.items.push(item);
  }
  
  get(index: number): T | undefined {
    return this.items[index];
  }
  
  getAll(): T[] {
    return this.items;
  }
  
  remove(item: T): void {
    const index = this.items.indexOf(item);
    if (index > -1) {
      this.items.splice(index, 1);
    }
  }
  
  get count(): number {
    return this.items.length;
  }
}

// Usage
const userStore = new DataStore<User>();
userStore.add({ id: 1, name: 'Alice', email: 'alice@ex.com' });

const numberStore = new DataStore<number>();
numberStore.add(42);
numberStore.add(100);`}
            language="typescript"
            colorTheme="purple"
          />

          <div className="mt-6 p-5 bg-white dark:bg-gray-900 rounded-xl border">
            <h5 className="font-semibold mb-3">Common Angular Generic Use Cases</h5>
