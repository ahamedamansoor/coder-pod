                <h4 className="font-semibold text-pink-900 dark:text-pink-100">Message Passing</h4>
              </div>
              <p className="text-sm text-gray-700 dark:text-gray-300">
                Communicate between main thread and worker using postMessage and onmessage events.
              </p>
            </div>

            <div className="p-5 rounded-xl bg-gradient-to-br from-rose-50 to-rose-100 dark:from-rose-950/30 dark:to-rose-900/30 border-2 border-rose-200 dark:border-rose-800/30">
              <div className="flex items-center gap-2 mb-2">
                <Clock className="w-5 h-5 text-rose-600 dark:text-rose-400" />
