
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get, update, delete: if isOwner();
      allow list: if false; // Disallow listing all users
      allow create: if isOwner();
      
      // Rules for the 'notes' subcollection
      match /notes/{noteId} {
        // Allow a user to read, update, or delete their own individual notes
        allow get, update, delete: if isOwner();
        
        // Allow a user to create a note for themselves
        allow create: if isOwner();
      }

      // Allow a user to list all the notes in their own 'notes' subcollection
      match /notes {
          allow list: if isOwner();
      }
    }
  }
}
