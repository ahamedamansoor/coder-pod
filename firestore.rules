/**
 * @fileoverview Firestore Security Rules for LinguaLeap application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and their sub-collections.
 * Only the authenticated user can read and write their own data.
 * Email verification is required to create a user profile document.
 *
 * Data Structure:
 * - User profiles: `/users/{userId}`
 * - User notes: `/users/{userId}/notes/{noteId}`
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - All write operations are validated against the authenticated user's UID.
 * - The `completedTopics` and `phoneNumber` fields can be updated by the owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces that only the authenticated user can read and write their own profile data and sub-collections.
     * @path /users/{userId}
     * @allow (get, update, delete) - An authenticated user can manage their own profile document.
     * @allow (create) - A user with a verified email can create their own profile.
     * @deny (list) - Listing all user profiles is forbidden.
     */
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      
      function isEmailVerified() {
          return request.auth.token.email_verified == true;
      }

      allow get, update, delete: if isOwner();
      allow list: if false;
      allow create: if isOwner() && isEmailVerified() && request.resource.data.id == userId;

      /**
       * @description Notebook sub-collection rules.
       * @path /users/{userId}/notes/{noteId}
       * @allow (read, write) - Only the owner of the notebook can read and write notes.
       */
      match /notes/{noteId} {
        allow read, write: if isOwner();
      }
    }
  }
}
