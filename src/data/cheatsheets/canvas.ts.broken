  });
});

// Complex path construction
class PathBuilder {
  constructor() {
    this.path = new Path2D();
  }
  
  moveTo(x, y) {
    this.path.moveTo(x, y);
    return this;
  }
  
  lineTo(x, y) {
    this.path.lineTo(x, y);
    return this;
  }
  
  arc(x, y, radius, startAngle, endAngle) {
    this.path.arc(x, y, radius, startAngle, endAngle);
    return this;
  }
  
  closePath() {
    this.path.closePath();
    return this;
  }
  
  getPath() {
    return this.path;
  }
}

const complexPath = new PathBuilder()
  .moveTo(400, 300)
  .lineTo(450, 350)
  .arc(400, 400, 50, Math.PI / 2, Math.PI * 1.5)
  .lineTo(350, 350)
  .closePath()
  .getPath();

ctx.fillStyle = 'purple';
ctx.fill(complexPath);`
