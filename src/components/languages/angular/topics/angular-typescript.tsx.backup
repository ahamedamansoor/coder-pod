            title="Angular tsconfig.json"
            description="Key compiler options"
            code={`{
  "compilerOptions": {
    // Target ES2022 for modern JavaScript
    "target": "ES2022",
    
    // Use ES modules
    "module": "ES2022",
    
    // Module resolution for Angular
    "moduleResolution": "node",
    
    // Strict type checking (recommended!)
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    
    // Additional checks
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    
    // Angular-specific
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    
    // For better IDE support
    "declaration": true,
    "sourceMap": true,
    
    // Library support
    "lib": ["ES2022", "dom"]
  }
}`}
            language="json"
            colorTheme="purple"
          />

