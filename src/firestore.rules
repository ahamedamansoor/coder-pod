
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, update, delete: if isOwner(userId);
      allow list: if false; // Security: Disallow listing all user documents
      allow create: if isOwner(userId);

      // Rules for the studySessions subcollection
      match /studySessions/{sessionId} {
        // Allow a user to read, create, update, and delete their own individual sessions.
        allow read, write: if isOwner(userId);
        
        // Allow a user to list all documents in their own studySessions subcollection.
        allow list: if isOwner(userId);
      }
    }
  }
}
