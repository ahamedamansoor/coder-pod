          usage: 'scale(), negative scaling for reflection',
          example: `const canvas = document.getElementById('myCanvas');
const ctx = canvas.getContext('2d');

// Scaling
ctx.save();
ctx.translate(100, 100);
ctx.scale(2, 2); // Double size
ctx.fillStyle = 'red';
ctx.fillRect(0, 0, 25, 25); // Appears as 50x50
ctx.restore();

// Non-uniform scaling
ctx.save();
ctx.translate(200, 100);
ctx.scale(3, 1); // 3x width, 1x height
ctx.fillStyle = 'blue';
ctx.fillRect(0, 0, 25, 25);
ctx.restore();

// Reflection (horizontal flip)
ctx.save();
ctx.translate(300, 100);
ctx.scale(-1, 1); // Flip horizontally
ctx.fillStyle = 'green';
ctx.fillRect(-25, -25, 50, 50);
ctx.restore();

// Reflection (vertical flip)
ctx.save();
ctx.translate(100, 200);
ctx.scale(1, -1); // Flip vertically
ctx.fillStyle = 'purple';
ctx.fillRect(-25, -25, 50, 50);
ctx.restore();

// Double reflection (both axes)
ctx.save();
ctx.translate(200, 200);
ctx.scale(-1, -1); // Flip both axes
ctx.fillStyle = 'orange';
ctx.fillRect(-25, -25, 50, 50);
ctx.restore();

// Combined transformations
ctx.save();
ctx.translate(300, 200);
ctx.scale(1.5, 1.5);
ctx.rotate(Math.PI / 4);
ctx.fillStyle = 'darkblue';
ctx.fillRect(-25, -25, 50, 50);
ctx.restore();

// Scaling with origin adjustment
function scaleFromPoint(x, y, scaleX, scaleY) {
  ctx.translate(x, y);
  ctx.scale(scaleX, scaleY);
  ctx.translate(-x, -y);
}

ctx.save();
scaleFromPoint(350, 250, 2, 2);
ctx.fillStyle = 'darkgreen';
ctx.fillRect(325, 225, 50, 50);
ctx.restore();`
