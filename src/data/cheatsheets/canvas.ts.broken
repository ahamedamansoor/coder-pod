// Solid colors
ctx.fillStyle = '#FF5733';
ctx.fillRect(50, 50, 100, 60);

ctx.strokeStyle = 'rgb(0, 128, 255)';
ctx.lineWidth = 3;
ctx.strokeRect(200, 50, 100, 60);

// RGBA with transparency
