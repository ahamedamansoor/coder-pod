              <Layers className="w-5 h-5 text-purple-600 dark:text-purple-400" />
            </div>
            <div>
              <CardTitle>How Web Workers Work</CardTitle>
              <CardDescription>Understanding the architecture</CardDescription>
            </div>
          </div>
        </CardHeader>
        <CardContent className="space-y-6">
          <div className="p-5 rounded-xl bg-gradient-to-r from-blue-50 to-cyan-50 dark:from-blue-950/20 dark:to-cyan-950/20 border-l-4 border-blue-500">
            <h4 className="font-bold text-blue-900 dark:text-blue-100 mb-3">🔄 Message Passing Architecture</h4>
            <p className="text-sm text-gray-700 dark:text-gray-300 mb-3">
              Main thread and Worker thread communicate through messages. Data is copied (not shared) between threads for safety.
            </p>
            <div className="grid md:grid-cols-2 gap-4 text-sm">
              <div className="p-3 bg-white dark:bg-slate-900 rounded-lg border border-blue-200 dark:border-blue-800">
                <strong className="text-blue-700 dark:text-blue-300">Main Thread:</strong>
                <ul className="mt-2 space-y-1 text-gray-600 dark:text-gray-400">
                  <li>→ Creates worker</li>
                  <li>→ Sends task via postMessage()</li>
                  <li>→ Receives result via onmessage</li>
                  <li>→ Updates UI</li>
                </ul>
              </div>
              <div className="p-3 bg-white dark:bg-slate-900 rounded-lg border border-cyan-200 dark:border-cyan-800">
                <strong className="text-cyan-700 dark:text-cyan-300">Worker Thread:</strong>
                <ul className="mt-2 space-y-1 text-gray-600 dark:text-gray-400">
                  <li>→ Receives task via onmessage</li>
                  <li>→ Performs computation</li>
                  <li>→ Sends result via postMessage()</li>
                  <li>→ No DOM access</li>
                </ul>
              </div>
            </div>
          </div>

          <CodeSnippet
            title="Example 1: Basic Number Crunching"
            description="Calculate factorial in background without blocking UI"
            code={`// worker.js
self.onmessage = function(e) {
  const number = e.data;
  
  // Heavy computation
  let result = 1;
  for (let i = 2; i <= number; i++) {
    result *= i;
  }
  
  // Send result back
  self.postMessage({
    input: number,
    result: result,
    message: 'Calculation complete!'
  });
};

// main.js
const worker = new Worker('worker.js');

// Send task to worker
worker.postMessage(10);

// Receive result
worker.onmessage = function(e) {
  console.log('Factorial of', e.data.input, '=', e.data.result);
  // Output: Factorial of 10 = 3628800
};`}
            language="javascript"
            colorTheme="purple"
          />

          <CodeSnippet
            title="Example 2: Processing Large Arrays"
            description="Filter and transform millions of records without freezing"
            code={`// worker.js - Data processing worker
self.onmessage = function(e) {
  const { data, operation } = e.data;
  
  let result;
  const startTime = Date.now();
  
  switch(operation) {
    case 'filter':
      result = data.filter(item => item.value > 50);
      break;
    case 'sum':
      result = data.reduce((acc, item) => acc + item.value, 0);
      break;
    case 'average':
      const sum = data.reduce((acc, item) => acc + item.value, 0);
      result = sum / data.length;
      break;
  }
  
  const timeTaken = Date.now() - startTime;
  
  self.postMessage({
    result: result,
    processedCount: data.length,
    timeTaken: timeTaken + 'ms'
  });
};

// main.js - Using the worker
const dataWorker = new Worker('worker.js');

// Generate large dataset (1 million items)
const largeData = Array.from({ length: 1000000 }, (_, i) => ({
  id: i,
  value: Math.random() * 100
}));

// UI stays responsive while worker processes data
dataWorker.postMessage({
  data: largeData,
  operation: 'filter'
});

dataWorker.onmessage = function(e) {
  console.log('Filtered', e.data.processedCount, 'items');
  console.log('Found', e.data.result.length, 'results');
  console.log('Time taken:', e.data.timeTaken);
  // Example output:
  // Filtered 1000000 items
  // Found 497234 results  
  // Time taken: 145ms
  // UI never froze!
};`}
            language="javascript"
            colorTheme="emerald"
          />

          <CodeSnippet
            title="Example 3: Real-Time Data Streaming"
            description="Worker continuously processes data and sends updates"
            code={`// streaming-worker.js
let isProcessing = false;

self.onmessage = function(e) {
  const { command, data } = e.data;
  
  if (command === 'start') {
    isProcessing = true;
    processStream(data);
  } else if (command === 'stop') {
    isProcessing = false;
  }
};

async function processStream(dataPoints) {
  for (let i = 0; i < dataPoints.length && isProcessing; i++) {
    // Process each chunk
    const processed = dataPoints[i] * 2; // Your processing logic
    
    // Send progress update
    self.postMessage({
      type: 'progress',
      current: i + 1,
      total: dataPoints.length,
      percentage: Math.round(((i + 1) / dataPoints.length) * 100),
      processedValue: processed
    });
    
    // Small delay to simulate processing
    await new Promise(resolve => setTimeout(resolve, 10));
  }
  
  self.postMessage({
    type: 'complete',
    message: 'All data processed!'
  });
}

// main.js
const streamWorker = new Worker('streaming-worker.js');

streamWorker.onmessage = function(e) {
  if (e.data.type === 'progress') {
    console.log(\`Progress: \${e.data.percentage}%\`);
    // Update progress bar in UI
    updateProgressBar(e.data.percentage);
  } else if (e.data.type === 'complete') {
    console.log('✓ Processing complete!');
  }
};

// Start processing
streamWorker.postMessage({
  command: 'start',
  data: Array.from({ length: 100 }, (_, i) => i)
});

// Can stop anytime
// streamWorker.postMessage({ command: 'stop' });`}
            language="javascript"
            colorTheme="blue"
          />

          <CodeSnippet
            title="Example 4: Error Handling & Timeouts"
            description="Properly handle errors and prevent infinite worker execution"
            code={`// worker-with-validation.js
self.onmessage = function(e) {
  try {
    const { numbers, operation } = e.data;
    
    // Validation
    if (!Array.isArray(numbers)) {
      throw new Error('Input must be an array');
    }
    
    if (numbers.length === 0) {
      throw new Error('Array cannot be empty');
    }
    
    let result;
    switch(operation) {
      case 'multiply':
        result = numbers.reduce((a, b) => a * b, 1);
        break;
      case 'divide':
        if (numbers.includes(0)) {
          throw new Error('Cannot divide by zero');
        }
        result = numbers.reduce((a, b) => a / b);
        break;
      default:
        throw new Error('Unknown operation: ' + operation);
    }
    
    self.postMessage({ success: true, result });
    
  } catch (error) {
    self.postMessage({ 
      success: false, 
      error: error.message 
    });
  }
};

// main.js - With timeout protection
function runWorkerWithTimeout(workerPath, data, timeout = 5000) {
  return new Promise((resolve, reject) => {
    const worker = new Worker(workerPath);
    let timeoutId;
    
    // Set timeout
    timeoutId = setTimeout(() => {
      worker.terminate();
      reject(new Error('Worker timeout - exceeded ' + timeout + 'ms'));
    }, timeout);
    
    worker.onmessage = function(e) {
      clearTimeout(timeoutId);
      worker.terminate();
      
      if (e.data.success) {
        resolve(e.data.result);
      } else {
        reject(new Error(e.data.error));
      }
    };
    
    worker.onerror = function(error) {
      clearTimeout(timeoutId);
      worker.terminate();
      reject(error);
    };
    
    worker.postMessage(data);
  });
}

// Usage with error handling
runWorkerWithTimeout('worker-with-validation.js', {
  numbers: [10, 5, 2],
  operation: 'multiply'
}, 3000)
  .then(result => {
    console.log('✓ Result:', result); // 100
  })
  .catch(error => {
    console.error('✗ Error:', error.message);
  });`}
            language="javascript"
            colorTheme="yellow"
          />
        </CardContent>
      </Card>

      {/* Interactive Web Worker Demo */}
      <FrontendCodePreview
        title="Web Worker: Heavy Computation Demo"
        html={`<div style="max-width: 700px; margin: 0 auto;">
  <h2 style="color: #a855f7; margin-bottom: 20px;">CPU-Intensive Task Comparison</h2>
  
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
