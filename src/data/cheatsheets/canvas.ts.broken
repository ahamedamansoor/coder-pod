<canvas id="myCanvas" width="800" height="600"></canvas>

<!-- Canvas with fallback content -->
<canvas id="myCanvas" width="800" height="600">
  Your browser does not support the canvas element.
</canvas>

<!-- Canvas with CSS styling -->
<style>
  canvas {
    border: 1px solid #000;
    background-color: #f0f0f0;
    display: block;
    margin: 0 auto;
  }
</style>

<canvas id="styledCanvas" width="800" height="600"></canvas>

<!-- Responsive canvas -->
<style>
  .responsive-canvas {
    max-width: 100%;
    height: auto;
  }
</style>

<canvas id="responsiveCanvas" class="responsive-canvas" width="800" height="600"></canvas>

