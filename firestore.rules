rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // A user can read, update, and delete their own document.
      allow get, update, delete: if isOwner(userId);
      // Any authenticated user can create their own user document.
      allow create: if isOwner(userId);
      // Nobody can list all users.
      allow list: if false;

      // A user can perform any action on their own subcollections.
      match /{allSubcollections}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
