          description: 'Get and initialize canvas drawing context',
          usage: 'Get 2D rendering context from canvas',
          example: `// Get canvas element
const canvas = document.getElementById('myCanvas');

// Get 2D rendering context
const ctx = canvas.getContext('2d');

// Check if canvas is supported
if (canvas.getContext) {
  const ctx = canvas.getContext('2d');
  // Canvas is supported, start drawing
} else {
  // Canvas is not supported
  console.log('Canvas not supported');
}

// Get WebGL context (for 3D graphics)
const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');

// Canvas context properties
console.log('Canvas width:', canvas.width);
console.log('Canvas height:', canvas.height);
console.log('Context type:', ctx.constructor.name);

// Set canvas size programmatically
canvas.width = 800;
canvas.height = 600;

// Clear canvas
ctx.clearRect(0, 0, canvas.width, canvas.height);

// Save and restore context state
ctx.save();
// Make changes to context
ctx.restore();`
