/**
 * @fileoverview Firestore Security Rules for LinguaLeap application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles.
 * Only the authenticated user can read and write their own profile data.
 * Email verification is required to create a user profile document.
 *
 * Data Structure:
 * All user data is stored under the `/users/{userId}` path, where `{userId}`
 * must match the authenticated user's UID.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent unauthorized data access.
 * - All write operations are validated against the authenticated user's UID
 *   to ensure data integrity and prevent impersonation.
 * - The `completedTopics` and `phoneNumber` fields can be updated by the owner.
 *
 * Denormalization for Authorization:
 * The `id` field within the `/users/{userId}` document MUST match the `{userId}`
 * path segment. This is validated on `create` and enforced immutably on `update`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces that only the authenticated user can read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) - A user with a verified email can create their own profile.
     * @allow (get, update, delete) - An authenticated user can manage their own profile document.
     * @deny (create) - User without a verified email cannot create a profile.
     * @deny (list) - Listing all user profiles is forbidden.
     * @principle Enforces document ownership and email verification for profile creation.
     */
    match /users/{userId} {
      // Helper function to check if the authenticated user is the owner of the document.
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      
      // Helper function to check if the user's email is verified.
      function isEmailVerified() {
          return request.auth.token.email_verified == true;
      }

      // Allow read access only to the owner of the document.
      allow get: if isOwner();

      // Explicitly deny list access to prevent enumeration of users.
      allow list: if false;

      // Allow creation of a user profile only if the user is authenticated,
      // their email is verified, and the document ID matches their UID.
      allow create: if isOwner() && isEmailVerified() && request.resource.data.id == userId;

      // Allow the owner to update their own profile.
      // Enforces that the 'id' field cannot be changed after creation.
      allow update: if isOwner() && request.resource.data.id == resource.data.id;

      // Allow the owner to delete their own profile.
      allow delete: if isOwner();
    }
  }
}
