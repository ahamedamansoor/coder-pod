
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get, update, delete: if isOwner();
      allow list: if false; // Disallow listing all users for security
      allow create: if isOwner();

      // Rules for the subcollection of study sessions
      match /studySessions/{sessionId} {
        // Allow a user to read and write their own individual sessions.
        allow read, write: if isOwner();
      }

      // Add this rule to allow the owner to LIST their own sessions.
      match /studySessions {
          allow list: if isOwner();
      }
    }
  }
}
