interface User {
  id: number;
  name: string;
  email: string;
  isActive: boolean;
}

// Optional properties
interface Product {
  id: number;
  name: string;
  description?: string;  // Optional
  price: number;
  tags?: string[];       // Optional array
}

// Readonly properties
interface Config {
  readonly apiUrl: string;
  readonly apiKey: string;
  timeout: number;
}

// Interface extending another interface
interface Admin extends User {
  role: string;
  permissions: string[];
}

// Method signatures in interfaces
interface Calculator {
  add(a: number, b: number): number;
  subtract(a: number, b: number): number;
}

// Usage
const user: User = {
  id: 1,
  name: 'Alice',
  email: 'alice@example.com',
  isActive: true
};

const admin: Admin = {
  id: 2,
  name: 'Bob',
  email: 'bob@example.com',
  isActive: true,
  role: 'superadmin',
  permissions: ['read', 'write', 'delete']
};`}
              language="typescript"
              colorTheme="purple"
            />

            <CodeSnippetWithOutput
              title="Type Aliases"
              description="Alternative way to define types"
              code={`// Type alias for primitive
type ID = string | number;

// Type alias for object
type Point = {
  x: number;
  y: number;
};

// Union types
type Status = 'pending' | 'approved' | 'rejected';
type Result = string | number | boolean;

// Intersection types
type Timestamp = {
  createdAt: Date;
  updatedAt: Date;
};

type UserWithTimestamp = User & Timestamp;

// Function types
type MathOperation = (a: number, b: number) => number;

// Generic type alias
type Response<T> = {
  data: T;
  status: number;
  message: string;
};

// Usage
let userId: ID = 123;
userId = 'abc-456'; // Also valid

let status: Status = 'pending';
// status = 'invalid'; // Error!

const multiply: MathOperation = (x, y) => x * y;

const apiResponse: Response<User> = {
  data: user,
  status: 200,
  message: 'Success'
};`}
              language="typescript"
