        </CardHeader>
        <CardContent>
          <CodeSnippetWithOutput
            title="Angular Component Class"
            description="TypeScript class with properties and methods"
            code={`import { Component } from '@angular/core';

// Interface for type safety
interface User {
  id: number;
  name: string;
  email: string;
}

@Component({
  selector: 'app-user-list',
  templateUrl: './user-list.component.html'
})
export class UserListComponent {
  // Properties with types
  title: string = 'User Management';
  users: User[] = [];
  selectedUser: User | null = null;
  isLoading: boolean = false;
  
  // Private property
  private apiUrl: string = 'https://api.example.com';
  
  // Constructor with dependency injection
  constructor(private userService: UserService) {
    this.loadUsers();
  }
  
  // Method with return type
  loadUsers(): void {
    this.isLoading = true;
    this.userService.getUsers().subscribe({
      next: (users: User[]) => {
        this.users = users;
        this.isLoading = false;
      },
      error: (error: Error) => {
        console.error('Failed to load users', error);
        this.isLoading = false;
      }
    });
  }
  
  // Method with parameter and return type
  selectUser(user: User): void {
    this.selectedUser = user;
  }
  
  // Getter (computed property)
  get userCount(): number {
    return this.users.length;
  }
  
  // Method with optional parameter
  deleteUser(userId: number, confirm: boolean = false): void {
    if (confirm) {
      this.userService.deleteUser(userId).subscribe();
    }
  }
}`}
            language="typescript"
            colorTheme="emerald"
          />

          <div className="mt-6 space-y-4">
            <div className="p-5 bg-gradient-to-br from-emerald-50 to-green-50 dark:from-emerald-950/10 dark:to-green-950/10 rounded-xl border border-emerald-200 dark:border-emerald-800">
              <h5 className="font-semibold mb-3 flex items-center gap-2">
