          command: 'Building Custom Canvas Library',
          description: 'Create your own canvas utility library',
          usage: 'Modular canvas library architecture',
          example: `// Custom Canvas Library Architecture

// Core Canvas class
class Canvas2D {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.width = canvas.width;
    this.height = canvas.height;
    
    this.objects = [];
    this.animationId = null;
    this.isAnimating = false;
  }
  
  // Object management
  add(object) {
    this.objects.push(object);
    return this;
  }
  
  remove(object) {
    const index = this.objects.indexOf(object);
    if (index > -1) {
      this.objects.splice(index, 1);
    }
    return this;
  }
  
  clear() {
    this.objects = [];
    return this;
  }
  
  // Rendering
  render() {
    this.ctx.clearRect(0, 0, this.width, this.height);
    
    // Sort objects by z-index
    this.objects.sort((a, b) => a.zIndex - b.zIndex);
    
    // Render all objects
    this.objects.forEach(object => {
      if (object.visible) {
        object.render(this.ctx);
      }
    });
    
    return this;
  }
  
  // Animation
  start() {
    if (!this.isAnimating) {
      this.isAnimating = true;
      this.animate();
    }
    return this;
  }
  
  stop() {
    this.isAnimating = false;
    if (this.animationId) {
      cancelAnimationFrame(this.animationId);
    }
    return this;
  }
  
  animate() {
    if (!this.isAnimating) return;
    
    // Update all objects
    this.objects.forEach(object => {
      if (object.update) {
        object.update();
      }
    });
    
    this.render();
    this.animationId = requestAnimationFrame(() => this.animate());
  }
  
  // Events
  on(event, handler) {
    this.canvas.addEventListener(event, handler);
    return this;
  }
  
  off(event, handler) {
    this.canvas.removeEventListener(event, handler);
    return this;
  }
}

// Base object class
class CanvasObject {
  constructor(x = 0, y = 0) {
    this.x = x;
    this.y = y;
    this.zIndex = 0;
    this.visible = true;
    this.rotation = 0;
    this.scaleX = 1;
    this.scaleY = 1;
  }
  
  render(ctx) {
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.rotation);
    ctx.scale(this.scaleX, this.scaleY);
    
    this.draw(ctx);
    
    ctx.restore();
  }
  
  draw(ctx) {
    // Override in subclasses
  }
  
  update() {
    // Override in subclasses
  }
}

// Rectangle class
class Rectangle extends CanvasObject {
  constructor(x, y, width, height, color = 'black') {
    super(x, y);
    this.width = width;
    this.height = height;
    this.color = color;
  }
  
  draw(ctx) {
    ctx.fillStyle = this.color;
    ctx.fillRect(-this.width/2, -this.height/2, this.width, this.height);
  }
}

// Circle class
class Circle extends CanvasObject {
  constructor(x, y, radius, color = 'black') {
    super(x, y);
    this.radius = radius;
    this.color = color;
  }
  
  draw(ctx) {
    ctx.fillStyle = this.color;
    ctx.beginPath();
    ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
    ctx.fill();
  }
}

// Text class
class Text extends CanvasObject {
  constructor(x, y, text, fontSize = 16, color = 'black') {
    super(x, y);
    this.text = text;
    this.fontSize = fontSize;
    this.color = color;
    this.font = 'Arial';
    this.textAlign = 'center';
    this.textBaseline = 'middle';
  }
  
  draw(ctx) {
    ctx.font = \`\${this.fontSize}px \${this.font}\`;
    ctx.fillStyle = this.color;
    ctx.textAlign = this.textAlign;
    ctx.textBaseline = this.textBaseline;
    ctx.fillText(this.text, 0, 0);
  }
}

// Animated sprite class
class Sprite extends CanvasObject {
  constructor(x, y, image, frameWidth, frameHeight, frameCount) {
    super(x, y);
    this.image = image;
    this.frameWidth = frameWidth;
    this.frameHeight = frameHeight;
    this.frameCount = frameCount;
    this.currentFrame = 0;
    this.animationSpeed = 100; // ms per frame
    this.lastFrameTime = 0;
  }
  
  update() {
    const now = Date.now();
    if (now - this.lastFrameTime > this.animationSpeed) {
      this.currentFrame = (this.currentFrame + 1) % this.frameCount;
      this.lastFrameTime = now;
    }
  }
  
  draw(ctx) {
    const sourceX = this.currentFrame * this.frameWidth;
    const sourceY = 0;
    
    ctx.drawImage(
      this.image,
      sourceX, sourceY, this.frameWidth, this.frameHeight,
      -this.frameWidth/2, -this.frameHeight/2, 
      this.frameWidth, this.frameHeight
    );
  }
}

// Particle system class
class ParticleSystem extends CanvasObject {
  constructor(x, y, particleCount = 100) {
    super(x, y);
    this.particles = [];
    this.particleCount = particleCount;
    this.initParticles();
  }
  
  initParticles() {
    for (let i = 0; i < this.particleCount; i++) {
      this.particles.push({
        x: 0,
        y: 0,
        vx: (Math.random() - 0.5) * 2,
        vy: (Math.random() - 0.5) * 2,
        life: 1,
        color: \`hsl(\${Math.random() * 360}, 70%, 50%)\`
      });
    }
  }
  
  update() {
    this.particles.forEach(particle => {
      particle.x += particle.vx;
      particle.y += particle.vy;
      particle.life -= 0.01;
      
      if (particle.life <= 0) {
        particle.x = 0;
        particle.y = 0;
        particle.life = 1;
      }
    });
  }
  
  draw(ctx) {
    this.particles.forEach(particle => {
      ctx.save();
      ctx.globalAlpha = particle.life;
      ctx.fillStyle = particle.color;
      ctx.beginPath();
      ctx.arc(particle.x, particle.y, 2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    });
  }
}

// Usage example
const canvas = new Canvas2D(document.getElementById('myCanvas'));

// Add objects
canvas.add(new Rectangle(200, 200, 100, 50, 'blue'))
      .add(new Circle(400, 200, 30, 'red'))
      .add(new Text(300, 100, 'Hello Canvas!', 24, 'black'))
      .add(new ParticleSystem(300, 300, 50));

// Start animation
canvas.start();

// Add interaction
canvas.on('click', (e) => {
  const rect = canvas.canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  
  // Add new circle at click position
  canvas.add(new Circle(x, y, 20, 'green'));
});

// Export library
export {
  Canvas2D,
  CanvasObject,
  Rectangle,
  Circle,
  Text,
  Sprite,
  ParticleSystem
};`
        },
        {
          command: 'Canvas Testing and Debugging',
          description: 'Test and debug canvas applications',
          usage: 'Testing strategies and debugging tools',
          example: `// Canvas Testing and Debugging

// 1. Unit testing canvas operations
class CanvasTestSuite {
  constructor() {
    this.tests = [];
    this.results = [];
  }
  
  addTest(name, testFn) {
    this.tests.push({ name, testFn });
  }
  
  async runTests() {
    this.results = [];
    
    for (const test of this.tests) {
      try {
        // Create test canvas
        const canvas = document.createElement('canvas');
        canvas.width = 100;
        canvas.height = 100;
        const ctx = canvas.getContext('2d');
        
        // Run test
        await test.testFn(ctx, canvas);
        
        this.results.push({ name: test.name, passed: true });
      } catch (error) {
        this.results.push({ name: test.name, passed: false, error: error.message });
      }
    }
    
    return this.results;
  }
}

// Example tests
const testSuite = new CanvasTestSuite();

testSuite.addTest('Rectangle Drawing', (ctx, canvas) => {
  ctx.fillStyle = 'red';
  ctx.fillRect(10, 10, 50, 50);
  
  const imageData = ctx.getImageData(30, 30, 1, 1);
  const pixel = imageData.data;
  
  if (pixel[0] !== 255 || pixel[1] !== 0 || pixel[2] !== 0) {
    throw new Error('Rectangle not drawn correctly');
  }
});

testSuite.addTest('Circle Drawing', (ctx, canvas) => {
  ctx.fillStyle = 'blue';
  ctx.beginPath();
  ctx.arc(50, 50, 20, 0, Math.PI * 2);
  ctx.fill();
  
  const imageData = ctx.getImageData(50, 50, 1, 1);
  const pixel = imageData.data;
  
  if (pixel[0] !== 0 || pixel[1] !== 0 || pixel[2] !== 255) {
    throw new Error('Circle not drawn correctly');
  }
});

// Run tests
testSuite.runTests().then(results => {
  console.log('Test Results:', results);
});

// 2. Visual debugging tools
class CanvasDebugger {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.debugMode = false;
    this.debugInfo = [];
  }
  
  enableDebugMode() {
    this.debugMode = true;
    this.setupDebugOverlay();
  }
  
  disableDebugMode() {
    this.debugMode = false;
    this.removeDebugOverlay();
  }
  
  setupDebugOverlay() {
    // Create debug overlay
    this.debugOverlay = document.createElement('div');
    this.debugOverlay.style.cssText = \`
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(0, 0, 0, 0.8);
      color: white;
      padding: 10px;
      font-family: monospace;
      font-size: 12px;
      border-radius: 5px;
      z-index: 1000;
    \`;
    
    document.body.appendChild(this.debugOverlay);
    this.updateDebugInfo();
  }
  
  removeDebugOverlay() {
    if (this.debugOverlay) {
      document.body.removeChild(this.debugOverlay);
      this.debugOverlay = null;
    }
  }
  
  updateDebugInfo() {
    if (!this.debugMode) return;
    
    const info = [
      \`Canvas Size: \${this.canvas.width}x\${this.canvas.height}\`,
      \`Context: \${this.ctx.constructor.name}\`,
      \`Transform: \${this.getTransformString()}\`,
      \`Fill Style: \${this.ctx.fillStyle}\`,
      \`Stroke Style: \${this.ctx.strokeStyle}\`,
      \`Line Width: \${this.ctx.lineWidth}\`,
      \`Global Alpha: \${this.ctx.globalAlpha}\`,
      \`Composite Operation: \${this.ctx.globalCompositeOperation}\`
    ];
    
    this.debugOverlay.innerHTML = info.join('<br>');
  }
  
  getTransformString() {
    const transform = this.ctx.getTransform();
    return \`[\${transform.a}, \${transform.b}, \${transform.c}, \${transform.d}, \${transform.e}, \${transform.f}]\`;
  }
  
  // Draw debug grid
  drawGrid(spacing = 50) {
    if (!this.debugMode) return;
    
    this.ctx.save();
    this.ctx.strokeStyle = 'rgba(255, 0, 0, 0.3)';
    this.ctx.lineWidth = 1;
    this.ctx.setLineDash([5, 5]);
    
    for (let x = 0; x <= this.canvas.width; x += spacing) {
      this.ctx.beginPath();
      this.ctx.moveTo(x, 0);
      this.ctx.lineTo(x, this.canvas.height);
      this.ctx.stroke();
    }
    
    for (let y = 0; y <= this.canvas.height; y += spacing) {
      this.ctx.beginPath();
      this.ctx.moveTo(0, y);
      this.ctx.lineTo(this.canvas.width, y);
      this.ctx.stroke();
    }
    
    this.ctx.restore();
  }
  
  // Highlight bounding boxes
  drawBoundingBox(x, y, width, height, label = '') {
    if (!this.debugMode) return;
    
    this.ctx.save();
    this.ctx.strokeStyle = 'red';
    this.ctx.lineWidth = 2;
    this.ctx.setLineDash([]);
    
    this.ctx.strokeRect(x, y, width, height);
    
    if (label) {
      this.ctx.fillStyle = 'red';
      this.ctx.font = '12px monospace';
      this.ctx.fillText(label, x, y - 5);
    }
    
    this.ctx.restore();
  }
}

// 3. Performance monitoring
class CanvasPerformanceMonitor {
  constructor(canvas) {
    this.canvas = canvas;
    this.frameCount = 0;
    this.lastTime = performance.now();
    this.fps = 0;
    this.frameTime = 0;
    this.memoryUsage = 0;
  }
  
  start() {
    this.monitor();
  }
  
  monitor() {
    const now = performance.now();
    const delta = now - this.lastTime;
    
    this.frameCount++;
    this.frameTime = delta;
    
    if (this.frameCount % 30 === 0) {
      this.fps = Math.round(1000 / delta);
      
      if (performance.memory) {
        this.memoryUsage = Math.round(performance.memory.usedJSHeapSize / 1048576);
      }
      
      this.updateDisplay();
    }
    
    this.lastTime = now;
    requestAnimationFrame(() => this.monitor());
  }
  
  updateDisplay() {
    const info = \`FPS: \${this.fps} | Frame Time: \${this.frameTime}ms | Memory: \${this.memoryUsage}MB\`;
    
    let display = document.getElementById('performance-display');
    if (!display) {
      display = document.createElement('div');
      display.id = 'performance-display';
      display.style.cssText = \`
        position: fixed;
        top: 10px;
        left: 10px;
        background: rgba(0, 0, 0, 0.8);
        color: #0f0;
        padding: 5px;
        font-family: monospace;
        font-size: 12px;
        z-index: 1000;
      \`;
      document.body.appendChild(display);
    }
    
    display.textContent = info;
  }
}

// 4. Error handling and recovery
class CanvasErrorHandler {
  constructor(canvas) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.errorCount = 0;
    this.maxErrors = 10;
  }
  
  wrapMethod(methodName, originalMethod) {
    return function(...args) {
      try {
        return originalMethod.apply(this.ctx, args);
      } catch (error) {
        this.handleError(error, methodName, args);
        return null;
      }
    }.bind(this);
  }
  
  handleError(error, methodName, args) {
    this.errorCount++;
    console.error(\`Canvas error in \${methodName}:\`, error);
    
    if (this.errorCount >= this.maxErrors) {
      console.error('Too many canvas errors, disabling canvas');
      this.disableCanvas();
    } else {
      // Try to recover
      this.recover();
    }
  }
  
  recover() {
    try {
      // Reset context state
      this.ctx.setTransform(1, 0, 0, 1, 0, 0);
      this.ctx.globalAlpha = 1;
      this.ctx.globalCompositeOperation = 'source-over';
      
      // Clear canvas
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      
      console.log('Canvas recovered from error');
    } catch (error) {
      console.error('Failed to recover canvas:', error);
    }
  }
  
  disableCanvas() {
    this.canvas.style.display = 'none';
    
    const errorMessage = document.createElement('div');
    errorMessage.textContent = 'Canvas disabled due to errors';
    errorMessage.style.cssText = 'color: red; font-weight: bold;';
    
    this.canvas.parentNode.insertBefore(errorMessage, this.canvas);
  }
}

// Usage example
const canvas = document.getElementById('myCanvas');
const debugger = new CanvasDebugger(canvas);
const monitor = new CanvasPerformanceMonitor(canvas);
const errorHandler = new CanvasErrorHandler(canvas);

debugger.enableDebugMode();
monitor.start();

// Wrap canvas methods for error handling
const originalFillRect = canvas.getContext('2d').fillRect;
canvas.getContext('2d').fillRect = errorHandler.wrapMethod('fillRect', originalFillRect);`
        },
      ],
