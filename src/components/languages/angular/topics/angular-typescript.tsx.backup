              <h5 className="font-semibold mb-3">Angular-Specific Example</h5>
              <CodeSnippetWithOutput
                title="Service Method"
                code={`// Create without ID
createUser(
  user: Omit<User, 'id'>
): Observable<User> {
  return this.http.post(url, user);
}

// Update with partial
updateUser(
  id: number,
  updates: Partial<User>
): Observable<User> {
  return this.http.patch(url, updates);
}`}
                language="typescript"
