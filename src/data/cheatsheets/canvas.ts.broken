radialGradient.addColorStop(0, 'white');
radialGradient.addColorStop(0.5, 'lightblue');
radialGradient.addColorStop(1, 'darkblue');
ctx.fillStyle = radialGradient;
ctx.fillRect(200, 150, 100, 60);

// Pattern
const patternCanvas = document.createElement('canvas');
patternCanvas.width = 10;
patternCanvas.height = 10;
const patternCtx = patternCanvas.getContext('2d');
patternCtx.fillStyle = 'lightgreen';
patternCtx.fillRect(0, 0, 5, 5);
patternCtx.fillRect(5, 5, 5, 5);
patternCtx.fillStyle = 'darkgreen';
patternCtx.fillRect(5, 0, 5, 5);
patternCtx.fillRect(0, 5, 5, 5);

const pattern = ctx.createPattern(patternCanvas, 'repeat');
ctx.fillStyle = pattern;
ctx.fillRect(350, 150, 100, 60);`
