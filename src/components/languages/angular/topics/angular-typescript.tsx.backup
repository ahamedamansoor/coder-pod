let names: string[] = ['Alice', 'Bob', 'Charlie'];
let emails: Array<string> = ['a@ex.com', 'b@ex.com'];

// Array of numbers
let scores: number[] = [95, 87, 92];

// Array of objects (inline type)
let users: { id: number; name: string }[] = [
  { id: 1, name: 'Alice' },
  { id: 2, name: 'Bob' }
];

// Object with typed properties
let user: {
  id: number;
  name: string;
  email: string;
  isActive: boolean;
} = {
  id: 1,
  name: 'John',
  email: 'john@example.com',
