          usage: 'OffscreenCanvas API for worker rendering',
          example: `// OffscreenCanvas for worker-based rendering

// Main thread
const canvas = document.getElementById('myCanvas');
const offscreen = canvas.transferControlToOffscreen();

// Send to worker
const worker = new Worker('canvas-worker.js');
worker.postMessage({ canvas: offscreen }, [offscreen]);

// Worker thread (canvas-worker.js)
self.onmessage = function(e) {
  const { canvas } = e.data;
  const ctx = canvas.getContext('2d');
  
  let animationId;
  
  function animate() {
    // Clear canvas
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    // Draw animated content
    const time = Date.now() * 0.001;
    
    ctx.fillStyle = 'blue';
    ctx.beginPath();
    ctx.arc(
      canvas.width / 2 + Math.cos(time) * 100,
      canvas.height / 2 + Math.sin(time) * 100,
      20,
      0,
      Math.PI * 2
    );
    ctx.fill();
    
    animationId = requestAnimationFrame(animate);
  }
  
  animate();
};

// Fallback for browsers without OffscreenCanvas support
function createFallbackOffscreen(width, height) {
  const canvas = document.createElement('canvas');
  canvas.width = width;
  canvas.height = height;
  return canvas;
}

// Check for OffscreenCanvas support
if (typeof OffscreenCanvas !== 'undefined') {
  const offscreen = new OffscreenCanvas(width, height);
  const ctx = offscreen.getContext('2d');
  
  // Use offscreen canvas
  ctx.fillStyle = 'red';
  ctx.fillRect(0, 0, 100, 100);
  
  // Transfer to main canvas
  const bitmap = offscreen.transferToImageBitmap();
  const mainCtx = canvas.getContext('2d');
  mainCtx.drawImage(bitmap, 0, 0);
} else {
  // Fallback
  const fallbackCanvas = createFallbackOffscreen(width, height);
  const ctx = fallbackCanvas.getContext('2d');
  
  ctx.fillStyle = 'red';
  ctx.fillRect(0, 0, 100, 100);
  
  const mainCtx = canvas.getContext('2d');
  mainCtx.drawImage(fallbackCanvas, 0, 0);
}

// Advanced OffscreenCanvas usage
class OffscreenRenderer {
  constructor(width, height) {
    this.canvas = new OffscreenCanvas(width, height);
    this.ctx = this.canvas.getContext('2d');
    this.width = width;
    this.height = height;
  }
  
  render(scene) {
    this.ctx.clearRect(0, 0, this.width, this.height);
    
    // Render scene
    scene.objects.forEach(obj => {
      this.ctx.save();
      this.ctx.translate(obj.x, obj.y);
      this.ctx.rotate(obj.rotation);
      
      this.ctx.fillStyle = obj.color;
      this.ctx.fillRect(-obj.width/2, -obj.height/2, obj.width, obj.height);
      
      this.ctx.restore();
    });
    
    return this.transferToBitmap();
  }
  
  transferToBitmap() {
    return this.canvas.transferToImageBitmap();
  }
}

// Usage in main thread
const renderer = new OffscreenRenderer(800, 600);

function renderFrame(scene) {
  const bitmap = renderer.render(scene);
  const mainCtx = canvas.getContext('2d');
  mainCtx.drawImage(bitmap, 0, 0);
}`
