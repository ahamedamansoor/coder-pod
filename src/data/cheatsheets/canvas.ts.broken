          command: 'Canvas Best Practices',
          description: 'Best practices for canvas development',
          usage: 'Guidelines for efficient canvas code',
          example: `// Canvas best practices

// 1. Use requestAnimationFrame for animations
function animate() {
  update();
  draw();
  requestAnimationFrame(animate);
}

// 2. Batch operations together
function drawBatch(objects) {
  objects.forEach(obj => {
    ctx.save();
    ctx.translate(obj.x, obj.y);
    ctx.rotate(obj.rotation);
    
    // Draw object
    ctx.fillStyle = obj.color;
    ctx.fillRect(-obj.width/2, -obj.height/2, obj.width, obj.height);
    
    ctx.restore();
  });
}

// 3. Use hardware acceleration hints
canvas.style.willChange = 'transform';
canvas.style.transform = 'translateZ(0)';

// 4. Optimize for high DPI displays
function setupHighDPICanvas(canvas) {
  const ctx = canvas.getContext('2d');
  const devicePixelRatio = window.devicePixelRatio || 1;
  
  // Set actual size in memory
  canvas.width = canvas.clientWidth * devicePixelRatio;
  canvas.height = canvas.clientHeight * devicePixelRatio;
  
  // Scale the drawing context
  ctx.scale(devicePixelRatio, devicePixelRatio);
  
  return ctx;
}

// 5. Use offscreen canvas for complex rendering
const offscreenCanvas = document.createElement('canvas');
offscreenCanvas.width = canvas.width;
offscreenCanvas.height = canvas.height;
const offCtx = offscreenCanvas.getContext('2d');

function renderComplexScene() {
  // Render to offscreen canvas first
  offCtx.clearRect(0, 0, offscreenCanvas.width, offscreenCanvas.height);
  
  // Complex drawing operations
  drawComplexElements(offCtx);
  
  // Copy to main canvas
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  ctx.drawImage(offscreenCanvas, 0, 0);
}

// 6. Minimize state changes
function drawOptimized(objects) {
  // Group by properties to minimize state changes
  const grouped = {};
  
  objects.forEach(obj => {
    const key = \`\${obj.fillStyle}-\${obj.strokeStyle}-\${obj.lineWidth}\`;
    if (!grouped[key]) {
      grouped[key] = [];
    }
    grouped[key].push(obj);
  });
  
  Object.keys(grouped).forEach(key => {
    const [fillStyle, strokeStyle, lineWidth] = key.split('-');
    
    ctx.fillStyle = fillStyle;
    ctx.strokeStyle = strokeStyle;
    ctx.lineWidth = parseInt(lineWidth);
    
    grouped[key].forEach(obj => {
      ctx.fillRect(obj.x, obj.y, obj.width, obj.height);
    });
  });
}

// 7. Use appropriate image formats
function loadImageOptimized(src) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    
    img.onload = () => {
      // Optimize image size if needed
      if (img.width > 1024 || img.height > 1024) {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        
        const scale = Math.min(1024 / img.width, 1024 / img.height);
        canvas.width = img.width * scale;
        canvas.height = img.height * scale;
        
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        
        const optimizedImg = new Image();
        optimizedImg.onload = () => resolve(optimizedImg);
        optimizedImg.src = canvas.toDataURL('image/jpeg', 0.8);
      } else {
        resolve(img);
      }
    };
    
    img.onerror = reject;
    img.src = src;
  });
}

// 8. Profile and measure performance
function measurePerformance(fn, label) {
  return function(...args) {
    const start = performance.now();
    const result = fn.apply(this, args);
    const end = performance.now();
    
    console.log(\`\${label}: \${end - start}ms\`);
    return result;
  };
}

// Usage
const drawOptimizedMeasured = measurePerformance(drawOptimized, 'drawOptimized');

// 9. Use appropriate canvas size
function resizeCanvas(canvas, container) {
  const rect = container.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  
  canvas.width = rect.width * dpr;
  canvas.height = rect.height * dpr;
  
  canvas.style.width = rect.width + 'px';
  canvas.style.height = rect.height + 'px';
  
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  
  return ctx;
}

// 10. Clean up properly
function cleanupCanvas(canvas) {
  const ctx = canvas.getContext('2d');
  
  // Clear all resources
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  
  // Remove event listeners
  canvas.removeEventListener('click', handleClick);
  canvas.removeEventListener('mousemove', handleMouseMove);
  
  // Cancel animations
  if (animationId) {
    cancelAnimationFrame(animationId);
  }
  
  // Clear references
  canvas.width = 0;
  canvas.height = 0;
}`
