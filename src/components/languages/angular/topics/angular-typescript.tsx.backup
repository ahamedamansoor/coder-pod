      {/* Utility Types */}
      <Card>
        <CardHeader>
          <CardTitle className="flex items-center gap-3 text-2xl">
            <Wrench className="w-6 h-6 text-amber-600/80 dark:text-amber-400/80" />
            TypeScript Utility Types
          </CardTitle>
