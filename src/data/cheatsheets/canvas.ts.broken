  const path = new Path2D();
  path.arc(x, y, size, 0, Math.PI * 2);
  return path;
}

const interactivePaths = [
  { path: createInteractivePath(100, 450, 30), color: 'red' },
  { path: createInteractivePath(200, 450, 30), color: 'green' },
  { path: createInteractivePath(300, 450, 30), color: 'blue' }
];

// Draw paths
interactivePaths.forEach(item => {
  ctx.fillStyle = item.color;
  ctx.fill(item.path);
});

// Click detection
canvas.addEventListener('click', (e) => {
  const rect = canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  
