// Tuple (fixed length and types)
let coordinate: [number, number] = [10, 20];
let person: [string, number] = ['Alice', 25];

// Readonly arrays (immutable)
let constants: readonly number[] = [1, 2, 3];
// constants.push(4); // Error! Cannot modify`}
